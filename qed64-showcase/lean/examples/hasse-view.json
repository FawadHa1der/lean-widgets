{
  "package": "hasse-view",
  "title": "HasseView",
  "blurb": "Hasse diagrams of finite orders with lattice diagnostics; click a cover edge, ⊥/⊤ or a no-join witness to insert a decided example.",
  "header": [
    "import Mathlib",
    "import HasseView"
  ],
  "cursors": [
    {
      "line": 17,
      "character": 0,
      "command": "#hasse (Finset (Fin 3))",
      "expect": {
        "svgTagCounts": {
          "rect": 8,
          "line": 12,
          "text": 16
        },
        "texts": [
          "Insertable examples (click to insert after the command)"

# Copy to .env.local (gitignored) and adjust. KEY=VALUE lines; a variable set in the environment wins.
# Read by scripts/lib/env.sh (bash) and scripts/lib/env.mjs (Node): every entry point loads it.
# `node scripts/lib/env.mjs` prints what is resolved.

# Heavy work dir (clones, olean trees, bakes, raw snapshots, logs; tens of GB; no spaces in the path).
QED64_SHOWCASE_WORK=$HOME/.cache/lean-widgets/qed64-showcase-work

# Artifact origins for `scripts/showcase.sh bootstrap` (scripts/fetch-artifacts.mjs; every file is sha256-checked against
# the committed lock, so an origin is never trusted):
#   ARTIFACT_ORIGIN        the showcase's own deployed origin (serves QED64's binaries AND our widget overlays), or
#                          scripts/serve.mjs of a checkout that has them (e.g. http://localhost:5190)
#   QED64_ARTIFACT_ORIGIN  an origin serving QED64's own binaries. QED64's live site serves them only for the release it
#                          deploys now (since QED64 4b98279 no other release's /runtime/ or /profiles/): for any other
#                          pin they come from ARTIFACT_ORIGIN
#ARTIFACT_ORIGIN=https://qed64-showcase.<account>.workers.dev
#QED64_ARTIFACT_ORIGIN=https://qed64.fawadworkaddress.workers.dev

# QED64's SOURCES need no variable: they are the git submodule deps/qed64 (clone with --recursive) and, for staged pins,
# git worktrees $QED64_SHOWCASE_WORK/qed64-pins/<id>.

# Read-only inputs of the HEAVY path only (rebuilding the overlays from source: docs/BUILD-FROM-SOURCE.md). Never
# written by any script; a clone that serves fetched artifacts needs none of them.
#   pin (registering a NEW pin from QED64's built binaries) and stage need QED64_REPO, and so does every reader of the
#   staged trees (bake, judge-bake, headless stage4/e2, hang-repro, all) for a pin whose servedTrees lie under it (every
#   pin before 521cf3f); native / stage / the goldens need the target pin's kernel build from QED64_KERNEL_BUILD (verify
#   checks it when there, else prints N/A for those rebuild-only inputs).
# A QED64 checkout at the pinned commit with QED64's binaries built (public/runtime chunks, packs, snapshots, work/).
#QED64_REPO=$HOME/src/QED64
# The wasm64 kernel build dir: native/stage1/{bin,lib}, native/NATIVE-COMMIT, mathlib/{MATHLIB-COMMIT,mathlib4,
# essential-modules.txt}, BUILT-COMMIT. One per Lean release, so give a ':'-separated list of them: every script takes
# the TARGET pin's (SHOWCASE_PIN, else the active pin), the first whose native/NATIVE-COMMIT and mathlib/MATHLIB-COMMIT
# are its lock's toolchain.native64.NATIVE_COMMIT and toolchain.mathlib.commit (the v4.35 build for 521cf3f, the v4.34
# build for the pins before it), so `pin use` needs no edit here. None of them -> native, stage and the goldens refuse,
# naming each rejected dir; verify prints N/A. A single dir works the same way. scripts/assert-untouched.sh watches
# every one listed (each must exist).
#QED64_KERNEL_BUILD=$HOME/src/wasm64-lean-kernel-build-v4.35.0:$HOME/src/wasm64-lean-kernel-build-v4.34.0
# Only for scripts/assert-untouched.sh (the trees it proves were not written):
#QED64_KERNEL_SRC=$HOME/src/wasm64-lean-kernel
#LEAN4GAME_DIR=$HOME/src/wasm64-lean4game

# Optional overrides. Two defaults follow the target pin (SHOWCASE_PIN, else the active pin):
#   LEAN_TOOLCHAIN_DIR  stock Lean for the goldens and native E3; default ~/.elan/toolchains/leanprover--lean4---v<the
#                       pin's runtime leanVersion> (v4.35.0 for 521cf3f, v4.34.0 for the pins before it; unset when the
#                       manifest is not on disk, except for those 4.34 pins). The goldens refuse unless it runs the
#                       packages' Lean (packages/*/lean-toolchain)
#   MATHLIB_CLONE       the Mathlib clone `native` builds into and `stage` reads; default
#                       $QED64_SHOWCASE_WORK/mathlib4.<first 8 hex of the pin lock's toolchain.mathlib.commit> when it
#                       exists (it must be at that commit), else the legacy $QED64_SHOWCASE_WORK/mathlib4 when its HEAD
#                       is that commit (pins up to 58ebbad)
#LEAN_TOOLCHAIN_DIR=$HOME/.elan/toolchains/leanprover--lean4---v4.35.0
#MATHLIB_CLONE=$HOME/.cache/lean-widgets/qed64-showcase-work/mathlib4.56a00585
#QED64_TOOLCHAIN_IMAGE=qed64-toolchain:emsdk-6.0.5
#BROWSER_LOCK_DIR=$HOME/.cache/host-browser-lock

# Copy to .env.local (gitignored) and adjust. KEY=VALUE lines; a variable set in the environment wins.
# Read by scripts/lib/env.sh (bash) and scripts/lib/env.mjs (Node): every entry point loads it.
# `node scripts/lib/env.mjs` prints what is resolved.

# Heavy work dir (clones, olean trees, bakes, raw snapshots, logs; tens of GB; no spaces in the path).
QED64_SHOWCASE_WORK=$HOME/.cache/lean-widgets/qed64-showcase-work

# Artifact origins for `scripts/showcase.sh bootstrap` (scripts/fetch-artifacts.mjs; every file is sha256-checked against
# the committed lock, so an origin is never trusted):
#   ARTIFACT_ORIGIN        the showcase's own deployed origin (serves QED64's binaries AND our widget overlays), or
#                          scripts/serve.mjs of a checkout that has them (e.g. http://localhost:5190)
#   QED64_ARTIFACT_ORIGIN  an origin serving QED64's own binaries (QED64's live site serves exactly these paths)
#ARTIFACT_ORIGIN=https://qed64-showcase.<account>.workers.dev
#QED64_ARTIFACT_ORIGIN=https://qed64.fawadworkaddress.workers.dev

# QED64's SOURCES need no variable: they are the git submodule deps/qed64 (clone with --recursive) and, for staged pins,
# git worktrees $QED64_SHOWCASE_WORK/qed64-pins/<id>.

# Read-only inputs of the HEAVY path only (rebuilding the overlays from source: docs/BUILD-FROM-SOURCE.md). Never
# written by any script; a clone that serves fetched artifacts needs none of them.
#   pin (registering a NEW pin from QED64's built binaries) and stage need QED64_REPO; native / stage need
#   QED64_KERNEL_BUILD (verify checks it when set, else prints N/A for those rebuild-only inputs).
# A QED64 checkout at the pinned commit with QED64's binaries built (public/runtime chunks, packs, snapshots, work/).
#QED64_REPO=$HOME/src/QED64
# The wasm64 kernel build dir: native/stage1/{bin,lib}, mathlib/{MATHLIB-COMMIT,mathlib4,essential-modules.txt}, BUILT-COMMIT.
#QED64_KERNEL_BUILD=$HOME/src/wasm64-lean-kernel-build-v4.34.0
# Only for scripts/assert-untouched.sh (the trees it proves were not written):
#QED64_KERNEL_SRC=$HOME/src/wasm64-lean-kernel
#LEAN4GAME_DIR=$HOME/src/wasm64-lean4game

# Optional overrides:
#LEAN_TOOLCHAIN_DIR=$HOME/.elan/toolchains/leanprover--lean4---v4.34.0
#QED64_TOOLCHAIN_IMAGE=qed64-toolchain:emsdk-6.0.5
#BROWSER_LOCK_DIR=$HOME/.cache/host-browser-lock

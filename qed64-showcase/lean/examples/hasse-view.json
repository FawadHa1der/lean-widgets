        "linkTexts": [
          "∅ ⋖ {0}",
          "∀ x, ∅ ≤ x",
          "∀ x, x ≤ {0, 1, 2}"
        ]
      }
    },
    {
      "line": 20,
      "character": 0,
      "command": "#hasse (Fin 4)",
      "expect": {}
    },
    {
      "line": 21,
      "character": 0,
